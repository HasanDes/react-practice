# Copy to .env.local (git-ignored) and adjust. Only VITE_* vars are exposed to the browser,
# so never put secrets here. None are required to run the app today.

# Base URL the data layer calls (wired up in D1-4).
VITE_API_BASE_URL=/api

# Serve the API from the in-browser mock instead of a real backend (D1-2).
VITE_USE_MOCK_API=true

# Base artificial latency for mock responses, in ms (D1-2 / D2-6).
VITE_MOCK_LATENCY_MS=300
